# ─────────────────────────────────────────────────────────────────────────────
# HEMOSAFE — Environment Variables Reference
# Copy to .env.dev (development) or .env.prod (production)
# NEVER commit .env.prod to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://hemosafe.gov.dz
DOMAIN=hemosafe.gov.dz

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=hemosafe
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hemosafe_prod

# PgBouncer connection pool (used by Prisma in production)
DATABASE_URL=postgresql://hemosafe:CHANGE_ME_STRONG_PASSWORD@pgbouncer:5432/hemosafe_prod?pgbouncer=true&connection_limit=1
# Direct connection (used for migrations)
DATABASE_DIRECT_URL=postgresql://hemosafe:CHANGE_ME_STRONG_PASSWORD@postgres:5432/hemosafe_prod

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_BYTES_HEX
JWT_EXPIRES_IN=15m

REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_BYTES_HEX
REFRESH_EXPIRES_IN=7d

# ── Docker Registry ─────────────────────────────────────────────────────────
REGISTRY=ghcr.io/your-org/hemosafe
IMAGE_TAG=latest

# ── Backups ─────────────────────────────────────────────────────────────────
BACKUP_S3_BUCKET=hemosafe-backups-prod
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=eu-west-3

# ── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PWD
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ── Alerts ───────────────────────────────────────────────────────────────────
ALERT_EMAIL=ops@hemosafe.gov.dz
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_MAX=120

# ── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://hemosafe.gov.dz

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=warn

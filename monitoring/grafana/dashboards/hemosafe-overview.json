{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki",       "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "HEMOSAFE — System Overview: API health, blood stock, infrastructure",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [

    {
      "id": 1, "type": "row",
      "title": "API Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2, "type": "stat",
      "title": "API Uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "red",   "value": 0 },
            { "color": "green", "value": 1 }
          ]},
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "targets": [{ "expr": "up{job=\"hemosafe-api\"}", "legendFormat": "API" }]
    },
    {
      "id": 3, "type": "stat",
      "title": "Request Rate (rps)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } },
      "targets": [{ "expr": "sum(rate(http_requests_total{job=\"hemosafe-api\"}[5m]))", "legendFormat": "req/s" }]
    },
    {
      "id": 4, "type": "stat",
      "title": "Error Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green",  "value": 0 },
            { "color": "yellow", "value": 0.01 },
            { "color": "red",    "value": 0.05 }
          ]}
        }
      },
      "targets": [{
        "expr": "sum(rate(http_requests_total{job=\"hemosafe-api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"hemosafe-api\"}[5m]))",
        "legendFormat": "5xx rate"
      }]
    },
    {
      "id": 5, "type": "stat",
      "title": "p99 Latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green",  "value": 0 },
            { "color": "yellow", "value": 0.5 },
            { "color": "red",    "value": 2 }
          ]}
        }
      },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"hemosafe-api\"}[5m])) by (le))",
        "legendFormat": "p99"
      }]
    },
    {
      "id": 6, "type": "stat",
      "title": "Active DB Connections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green",  "value": 0 },
            { "color": "yellow", "value": 80 },
            { "color": "red",    "value": 150 }
          ]}
        }
      },
      "targets": [{ "expr": "pg_stat_activity_count{datname=\"hemosafe_prod\"}", "legendFormat": "connections" }]
    },

    {
      "id": 10, "type": "row",
      "title": "Blood Stock",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 11, "type": "bargauge",
      "title": "Available Blood Bags by Type",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "minVizWidth": 0,
        "minVizHeight": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "red",    "value": 0 },
            { "color": "orange", "value": 5 },
            { "color": "yellow", "value": 20 },
            { "color": "green",  "value": 50 }
          ]}
        }
      },
      "targets": [{
        "expr": "sum by (blood_type) (hemosafe_blood_bags_available_total)",
        "legendFormat": "{{ blood_type }}"
      }]
    },
    {
      "id": 12, "type": "table",
      "title": "Critical Stock Facilities",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": { "showHeader": true },
      "targets": [{
        "expr": "hemosafe_blood_bags_available_total < 10",
        "legendFormat": "{{ facility }} — {{ blood_type }}",
        "instant": true,
        "format": "table"
      }]
    },

    {
      "id": 20, "type": "row",
      "title": "Infrastructure",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 21, "type": "timeseries",
      "title": "CPU Usage by Container",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{
        "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"hemosafe\"}[1m]))",
        "legendFormat": "{{ container_label_com_docker_compose_service }}"
      }]
    },
    {
      "id": 22, "type": "timeseries",
      "title": "Memory Usage by Container",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{
        "expr": "container_memory_working_set_bytes{container_label_com_docker_compose_project=\"hemosafe\",container_label_com_docker_compose_service!=\"\"}",
        "legendFormat": "{{ container_label_com_docker_compose_service }}"
      }]
    },

    {
      "id": 30, "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "id": 31, "type": "logs",
      "title": "API Error Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "options": { "showTime": true, "showLabels": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{service=\"api\", level=~\"error|warn\"}", "legendFormat": "" }]
    }

  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hemosafe", "overview"],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "title": "HEMOSAFE — Overview",
  "uid": "hemosafe-overview",
  "version": 1
}

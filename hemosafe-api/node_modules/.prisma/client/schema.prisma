// =============================================================================
// HEMOSAFE — Prisma Schema
// Database: PostgreSQL + PostGIS
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), postgis, pgTrgm(map: "pg_trgm")]
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  ADMIN
  HOSPITAL
  BLOOD_BANK
}

enum FacilityType {
  HOSPITAL
  BLOOD_BANK
}

enum AboGroup {
  A
  B
  AB
  O
}

enum RhFactor {
  POSITIVE @map("+")
  NEGATIVE @map("-")
}

enum BagStatus {
  AVAILABLE
  RESERVED
  DISTRIBUTED
  EXPIRED
  DISCARDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  DELIVERED
  EXPIRED
  CANCELLED
}

enum UrgencyLevel {
  ROUTINE
  URGENT
  EMERGENCY
}

enum MovementType {
  RECEIVED
  RESERVED
  RELEASED
  DISTRIBUTED
  EXPIRED
  DISCARDED
  TRANSFERRED
}

enum TransferStatus {
  INITIATED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK
  RESERVATION_CONFIRMED
  RESERVATION_EXPIRED
  BAG_EXPIRING_SOON
  TRANSFER_RECEIVED
  PRESCRIPTION_FILLED
  SYSTEM
}

enum SyncOperationType {
  POST
  PUT
  PATCH
  DELETE
}

enum SyncStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// =============================================================================
// MODELS
// =============================================================================

model Region {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(100)
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  parent     Region?    @relation("RegionHierarchy", fields: [parentId], references: [id])
  children   Region[]   @relation("RegionHierarchy")
  facilities Facility[]

  @@map("regions")
}

model BloodType {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  aboGroup        AboGroup @map("abo_group")
  rhFactor        RhFactor @map("rh_factor")
  label           String   @unique @db.VarChar(4)
  // compatibleDonor is stored as text[] in PG — read via raw query when needed
  compatibleDonor String[] @map("compatible_donor")

  donors        Donor[]
  bloodBags     BloodBag[]
  patients      Patient[]
  prescriptions Prescription[]
  reservations  Reservation[]

  @@unique([aboGroup, rhFactor])
  @@map("blood_types")
}

model Facility {
  id        String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type      FacilityType
  name      String       @db.VarChar(200)
  code      String       @unique @db.VarChar(30)
  address   String
  regionId  String       @map("region_id") @db.Uuid
  // PostGIS geography — read/write via $queryRaw
  phone     String?      @db.VarChar(30)
  email     String?      @db.VarChar(150)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  region             Region        @relation(fields: [regionId], references: [id])
  users              User[]
  bloodBagsAsBank    BloodBag[]    @relation("BagBloodBank")
  donorsRegistered   Donor[]       @relation("DonorRegisteredBank")
  reservationsAsHosp Reservation[] @relation("ReservationHospital")
  reservationsAsBank Reservation[] @relation("ReservationBloodBank")
  transfersFrom      Transfer[]    @relation("TransferFrom")
  transfersTo        Transfer[]    @relation("TransferTo")
  patients           Patient[]

  @@map("facilities")
}

model User {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  facilityId   String?   @map("facility_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  mfaSecret    String?   @map("mfa_secret") @db.VarChar(64)
  refreshToken String?   @map("refresh_token")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  facility       Facility?         @relation(fields: [facilityId], references: [id])
  reservations   Reservation[]     @relation("ReservationRequestedBy")
  prescriptions  Prescription[]    @relation("PrescriptionPhysician")
  screenings     HealthScreening[] @relation("ScreeningPerformedBy")
  notifications  Notification[]
  transfersInit  Transfer[]        @relation("TransferInitiatedBy")
  transfersRecv  Transfer[]        @relation("TransferReceivedBy")
  stockMovements StockMovement[]   @relation("MovementPerformedBy")
  auditLogs      AuditLog[]

  @@map("users")
}

model Donor {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nationalId          String    @unique @map("national_id") @db.VarChar(30)
  firstName           String    @map("first_name") @db.VarChar(100)
  lastName            String    @map("last_name") @db.VarChar(100)
  dob                 DateTime  @db.Date
  bloodTypeId         String    @map("blood_type_id") @db.Uuid
  phone               String?   @db.VarChar(30)
  email               String?   @db.VarChar(150)
  isEligible          Boolean   @default(true) @map("is_eligible")
  ineligibilityReason String?   @map("ineligibility_reason")
  lastDonationAt      DateTime? @map("last_donation_at") @db.Timestamptz()
  donationCount       Int       @default(0) @map("donation_count")
  registeredBankId    String?   @map("registered_bank_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  bloodType      BloodType         @relation(fields: [bloodTypeId], references: [id])
  registeredBank Facility?         @relation("DonorRegisteredBank", fields: [registeredBankId], references: [id])
  screenings     HealthScreening[]
  bloodBags      BloodBag[]

  @@map("donors")
}

model HealthScreening {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  donorId       String   @map("donor_id") @db.Uuid
  screenedBy    String?  @map("screened_by") @db.Uuid
  screenedAt    DateTime @default(now()) @map("screened_at") @db.Timestamptz()
  hemoglobinGDl Decimal? @map("hemoglobin_g_dl") @db.Decimal(4, 1)
  bloodPressure String?  @map("blood_pressure") @db.VarChar(10)
  weightKg      Decimal? @map("weight_kg") @db.Decimal(5, 1)
  temperatureC  Decimal? @map("temperature_c") @db.Decimal(4, 1)
  isPassed      Boolean  @map("is_passed")
  notes         String?

  donor     Donor      @relation(fields: [donorId], references: [id])
  screener  User?      @relation("ScreeningPerformedBy", fields: [screenedBy], references: [id])
  bloodBags BloodBag[]

  @@map("health_screenings")
}

model BloodBag {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code            String    @unique @db.VarChar(50)
  bloodTypeId     String    @map("blood_type_id") @db.Uuid
  donorId         String?   @map("donor_id") @db.Uuid
  screeningId     String?   @map("screening_id") @db.Uuid
  bloodBankId     String    @map("blood_bank_id") @db.Uuid
  volumeMl        Int       @map("volume_ml") @db.SmallInt
  collectedAt     DateTime  @map("collected_at") @db.Timestamptz()
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz()
  status          BagStatus @default(AVAILABLE)
  discardedReason String?   @map("discarded_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  bloodType       BloodType        @relation(fields: [bloodTypeId], references: [id])
  donor           Donor?           @relation(fields: [donorId], references: [id])
  screening       HealthScreening? @relation(fields: [screeningId], references: [id])
  bloodBank       Facility         @relation("BagBloodBank", fields: [bloodBankId], references: [id])
  reservationBags ReservationBag[]
  stockMovements  StockMovement[]
  transferBags    TransferBag[]

  @@map("blood_bags")
}

model Patient {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  hospitalId      String    @map("hospital_id") @db.Uuid
  nationalId      String?   @unique @map("national_id") @db.VarChar(30)
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  dob             DateTime? @db.Date
  bloodTypeId     String?   @map("blood_type_id") @db.Uuid
  medicalRecordNo String?   @map("medical_record_no") @db.VarChar(50)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  hospital      Facility       @relation(fields: [hospitalId], references: [id])
  bloodType     BloodType?     @relation(fields: [bloodTypeId], references: [id])
  prescriptions Prescription[]

  @@map("patients")
}

model Prescription {
  id            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patientId     String       @map("patient_id") @db.Uuid
  physicianId   String       @map("physician_id") @db.Uuid
  hospitalId    String       @map("hospital_id") @db.Uuid
  bloodTypeId   String       @map("blood_type_id") @db.Uuid
  quantity      Int          @db.SmallInt
  urgency       UrgencyLevel @default(ROUTINE)
  clinicalNotes String?      @map("clinical_notes")
  isFulfilled   Boolean      @default(false) @map("is_fulfilled")
  fulfilledAt   DateTime?    @map("fulfilled_at") @db.Timestamptz()
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz()
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  patient      Patient       @relation(fields: [patientId], references: [id])
  physician    User          @relation("PrescriptionPhysician", fields: [physicianId], references: [id])
  bloodType    BloodType     @relation(fields: [bloodTypeId], references: [id])
  reservations Reservation[]

  @@map("prescriptions")
}

model Reservation {
  id             String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code           String            @unique @db.VarChar(20)
  hospitalId     String            @map("hospital_id") @db.Uuid
  bloodBankId    String            @map("blood_bank_id") @db.Uuid
  prescriptionId String?           @map("prescription_id") @db.Uuid
  requestedBy    String            @map("requested_by") @db.Uuid
  bloodTypeId    String            @map("blood_type_id") @db.Uuid
  quantity       Int               @db.SmallInt
  urgency        UrgencyLevel      @default(ROUTINE)
  status         ReservationStatus @default(PENDING)
  notes          String?
  expiresAt      DateTime          @default(dbgenerated("(NOW() + INTERVAL '24 hours')")) @map("expires_at") @db.Timestamptz()
  confirmedAt    DateTime?         @map("confirmed_at") @db.Timestamptz()
  dispatchedAt   DateTime?         @map("dispatched_at") @db.Timestamptz()
  deliveredAt    DateTime?         @map("delivered_at") @db.Timestamptz()
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz()
  cancelReason   String?           @map("cancel_reason")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  hospital        Facility         @relation("ReservationHospital", fields: [hospitalId], references: [id])
  bloodBank       Facility         @relation("ReservationBloodBank", fields: [bloodBankId], references: [id])
  prescription    Prescription?    @relation(fields: [prescriptionId], references: [id])
  requester       User             @relation("ReservationRequestedBy", fields: [requestedBy], references: [id])
  bloodType       BloodType        @relation(fields: [bloodTypeId], references: [id])
  reservationBags ReservationBag[]
  stockMovements  StockMovement[]

  @@map("reservations")
}

model ReservationBag {
  reservationId String   @map("reservation_id") @db.Uuid
  bloodBagId    String   @map("blood_bag_id") @db.Uuid
  allocatedAt   DateTime @default(now()) @map("allocated_at") @db.Timestamptz()

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  bloodBag    BloodBag    @relation(fields: [bloodBagId], references: [id])

  @@id([reservationId, bloodBagId])
  @@map("reservation_bags")
}

model StockMovement {
  id            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bloodBagId    String       @map("blood_bag_id") @db.Uuid
  movementType  MovementType @map("movement_type")
  fromStatus    BagStatus    @map("from_status")
  toStatus      BagStatus    @map("to_status")
  performedBy   String?      @map("performed_by") @db.Uuid
  reservationId String?      @map("reservation_id") @db.Uuid
  transferId    String?      @map("transfer_id") @db.Uuid
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  bloodBag    BloodBag     @relation(fields: [bloodBagId], references: [id])
  performer   User?        @relation("MovementPerformedBy", fields: [performedBy], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  transfer    Transfer?    @relation(fields: [transferId], references: [id])

  @@map("stock_movements")
}

model Transfer {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code        String         @unique @db.VarChar(20)
  fromBankId  String         @map("from_bank_id") @db.Uuid
  toBankId    String         @map("to_bank_id") @db.Uuid
  initiatedBy String         @map("initiated_by") @db.Uuid
  receivedBy  String?        @map("received_by") @db.Uuid
  status      TransferStatus @default(INITIATED)
  reason      String?
  initiatedAt DateTime       @default(now()) @map("initiated_at") @db.Timestamptz()
  inTransitAt DateTime?      @map("in_transit_at") @db.Timestamptz()
  receivedAt  DateTime?      @map("received_at") @db.Timestamptz()
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  fromBank       Facility        @relation("TransferFrom", fields: [fromBankId], references: [id])
  toBank         Facility        @relation("TransferTo", fields: [toBankId], references: [id])
  initiator      User            @relation("TransferInitiatedBy", fields: [initiatedBy], references: [id])
  receiver       User?           @relation("TransferReceivedBy", fields: [receivedBy], references: [id])
  transferBags   TransferBag[]
  stockMovements StockMovement[]

  @@map("transfers")
}

model TransferBag {
  transferId String @map("transfer_id") @db.Uuid
  bloodBagId String @map("blood_bag_id") @db.Uuid

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  bloodBag BloodBag @relation(fields: [bloodBagId], references: [id])

  @@id([transferId, bloodBagId])
  @@map("transfer_bags")
}

model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz()
  metadata  Json             @default("{}")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        BigInt    @id @default(autoincrement())
  userId    String?   @map("user_id") @db.Uuid
  role      UserRole?
  action    String    @db.VarChar(100)
  entity    String    @db.VarChar(60)
  entityId  String?   @map("entity_id") @db.Uuid
  oldValue  Json?     @map("old_value")
  newValue  Json?     @map("new_value")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SyncQueue {
  id           BigInt            @id @default(autoincrement())
  userId       String            @map("user_id") @db.Uuid
  facilityId   String?           @map("facility_id") @db.Uuid
  operationId  String            @unique @map("operation_id") @db.Uuid
  method       SyncOperationType
  endpoint     String            @db.VarChar(255)
  payload      Json              @default("{}")
  status       SyncStatus        @default(PENDING)
  retries      Int               @default(0) @db.SmallInt
  errorMessage String?           @map("error_message")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  processedAt  DateTime?         @map("processed_at") @db.Timestamptz()

  @@map("sync_queue")
}
